# 온디바이스 추론 모델은 바이너리라 diff 가 의미 없고 수십 MB 라 LFS 로 둔다.
# FP32 원본(depth_anything_v2_vits.onnx)은 레포에 넣지 않는다 — .gitignore 참고.
assets/models/*.onnx filter=lfs diff=lfs merge=lfs -text
android/app/src/main/assets/models/*.task filter=lfs diff=lfs merge=lfs -text
assets/videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
