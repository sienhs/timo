<?xml version="1.0" encoding="utf-8"?>
<!--
    Flutter 엔진이 첫 프레임을 그리기 전까지 안드로이드가 보여 주는 런치 화면
    (안드로이드 5.0 미만). 5.0 이상은 drawable-v21/ 의 같은 파일을 쓴다.

    Flutter 로딩 화면(features/splash)의 배경과 같은 흰색이다. 두 파일의 값을
    맞춰 두어야 다크 모드에서도 색이 튀지 않는다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
</layer-list>
