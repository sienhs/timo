SPRING_PROFILES_ACTIVE=prod

# ─── Database ──────────────────────────────────
# 파라미터 필수: connectionTimeZone (KST 단일 저장 규약)
DB_URL=jdbc:mysql://mysql:3306/timo?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=timo
DB_PASSWORD=

# ─── Redis ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────
# HS256 대칭키. 반드시 32바이트(256비트) 이상 — 짧으면 런타임에 예외
JWT_SECRET=

# ─── SolAPI ────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
SMS_LIVE_TEST_TO=