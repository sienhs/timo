###############################################################################
# 회원가입 인증 - 실패 케이스
#
# auth-common.http 를 먼저 실행해 {{takenPhone}}, {{deviceId}} 를 채워 둬야 한다.
# 도메인 예외 응답에는 errorCode 가 없고 exception 이 실린다(GlobalExceptionHandler).
#
# 1번과 2번은 짝이다. 1번이 같은 번호의 쿨다운을 소모하기 때문에 2번이 429 가 된다.
# 1분 안에 이 파일을 다시 돌리면 1번부터 429 가 나온다. 그때는 1분 기다린다.
###############################################################################

### 1. 이미 가입된 번호는 문자를 보내기 전에 409 로 끊는다
POST {{baseUrl}}/api/v1/auth/sms/send
Content-Type: application/json

{
  "phoneNumber": "{{takenPhone}}"
}

> {%
    client.test("409 PhoneNumberDuplicatedException", function () {
        client.assert(response.status === 409, "status: " + response.status);
        client.assert(response.body.exception === "PhoneNumberDuplicatedException", "exception: " + response.body.exception);
    });
    client.log("콘솔에 [SMS NOT SENT] 가 찍히지 않아야 한다 - 문자를 아예 만들지 않는다");
%}

### 2. 중복으로 거절돼도 발송 제한은 이미 소모됐다
POST {{baseUrl}}/api/v1/auth/sms/send
Content-Type: application/json

{
  "phoneNumber": "{{takenPhone}}"
}

> {%
    client.test("429 SmsSendLimitExceededException", function () {
        client.assert(response.status === 429, "status: " + response.status);
        client.assert(response.body.exception === "SmsSendLimitExceededException", "exception: " + response.body.exception);
    });
    client.log("여기가 409 면 중복 검사가 제한 검사보다 앞에 있다는 뜻이다 - 번호를 긁을 수 있게 된다");
%}

### 3. 형식이 틀린 번호는 400
POST {{baseUrl}}/api/v1/auth/sms/send
Content-Type: application/json

{
  "phoneNumber": "0212345678"
}

> {%
    client.test("400 이고 어느 필드가 틀렸는지 알려준다", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.errors[0].field === "phoneNumber", "field: " + JSON.stringify(response.body.errors));
    });
%}

### 4. 없는 티켓으로는 가입할 수 없다
POST {{baseUrl}}/api/v1/auth/signup
X-Device-Id: {{deviceId}}
Content-Type: application/json

{
  "verificationTicket": "이런티켓은없다",
  "phoneNumber": "01088889999",
  "name": "정희성",
  "username": "timo_ghost",
  "password": "timo1234!",
  "nickname": "유령티모"
}

> {%
    client.test("400 VerificationTicketInvalidException", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.exception === "VerificationTicketInvalidException", "exception: " + response.body.exception);
    });
%}

### 5. X-Device-Id 가 없으면 가입할 수 없다
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "verificationTicket": "이런티켓은없다",
  "phoneNumber": "01088889999",
  "name": "정희성",
  "username": "timo_ghost",
  "password": "timo1234!",
  "nickname": "유령티모"
}

> {%
    client.test("400 MissingRequestHeaderException", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.exception === "MissingRequestHeaderException", "exception: " + response.body.exception);
    });
%}
