###############################################################################
# 회원가입 인증 API 공통 준비
#
# 실행 순서: auth-common.http -> auth-success.http -> auth-fail.http
# local 프로필로 띄우고 우측 상단에서 env 를 local 로 고른다({{baseUrl}}).
#
# 이 흐름은 인증이 필요 없다. 가입 API 는 permitAll 이라 토큰 없이 부른다.
# 대신 X-Device-Id 헤더가 필수다. 가입, 로그인, 재발급, 로그아웃이 같은 값을 써야
# 한 기기에 세션이 둘 생기지 않는다.
#
# local 은 문자를 보내지 않는다. LoggingSmsSender 가 콘솔에 남기는
# "[SMS NOT SENT] phoneNumber=..., code=......" 줄에서 여섯 자리를 읽어
# auth-success.http 의 {{smsCode}} 에 손으로 넣는다.
#
# 발송 제한이 있으니 막히면 번호를 바꾼다.
# 번호당 하루 5회, 같은 번호 1분 쿨다운, IP 당 1시간 20회.
###############################################################################

### 아직 가입되지 않은 번호를 하나 정한다
# 이 번호가 이미 쓰이면 409 가 난다. 그때는 뒷자리를 바꾼다.
GET {{baseUrl}}/api/v1/auth/availability?username=timo_new_user

> {%
    client.test("아이디 중복 확인이 응답한다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("newPhone", "01088880001");
    client.global.set("newUsername", "timo_new_user");
    client.global.set("newNickname", "새로운티모");
    client.global.set("deviceId", "22222222-2222-2222-2222-222222222222");
    client.log("가입에 쓸 번호 01088880001, 아이디 timo_new_user");
%}

### 이미 가입된 번호 하나를 확보한다 - 시드 회원으로 로그인해 본인 정보를 읽는다
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 11111111-1111-1111-1111-111111111111
Content-Type: application/json

{
  "username": "seed001",
  "password": "timo1234!"
}

> {%
    client.test("시드 회원으로 로그인된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("token", response.body.accessToken);
%}

### 시드 회원의 번호는 마스킹돼 내려온다 - 원본은 시더 규칙으로 안다
# SEED_MEMBER_PHONE_PREFIX = "0109900" 이고 뒤에 순번이 붙는다. seed001 은 0109900001.
GET {{baseUrl}}/api/v1/members/me
Authorization: Bearer {{token}}

> {%
    client.test("본인 정보를 읽는다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("takenPhone", "01099000001");
    client.log("이미 가입된 번호로 01099000001 을 쓴다 - 시더가 만든 seed001 의 번호다");
%}
