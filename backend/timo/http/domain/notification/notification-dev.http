###############################################################################
# 알림 스윕 수동 트리거 (개발용)
#
# local 또는 demo 프로필로 띄웠을 때만 있다. 운영에는 이 경로가 없다(404).
# 우측 상단에서 env 를 local 로 고른다({{baseUrl}}).
#
# 왜 필요한가: 시드 공연의 날짜가 알림이 나가는 시간 창에 걸리지 않아서, 그냥 두면 알림이
# 하나도 생기지 않는다. 그래서 기준 시각(at)을 지정해 "그 시각인 것처럼" 스윕을 돌린다.
#
# 시각을 고르는 법: 시드 공연의 오픈 시각과 시작 시각에서 알림 시각을 거꾸로 센다.
#   입장 가능      공연 시작 2시간 전 ~ 1시간 사이(보정 구간)
#   예매 오픈 안내  오픈 날짜의 7일 전 09:00, 하루 전 09:00, 오픈 1시간 전
#   공연 일정      공연 날짜의 7일 전 09:00, 하루 전 09:00, 당일 09:00
#   양도 매물      매일 08:00(마켓 여는 시각) 부터 1시간 안, 어제 등록된 매물이 있을 때
# 예) 오픈이 9월 27일 20시인 공연의 7일 전 알림은 at=2026-09-20T09:00:00 이다.
#
# 같은 at 으로 두 번 부르면 두 번째는 0건이다(중복 방지). 다른 at 은 새 알림이 된다.
# 알림은 요청자와 무관하게 대상 회원 모두에게 만들어진다. 확인은 그 회원으로 로그인해서 한다.
###############################################################################

### 로그인 - 알림을 받을 회원(찜하거나 티켓을 가진 시드 회원)
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 11111111-1111-1111-1111-111111111111
Content-Type: application/json

{
  "username": "seed001",
  "password": "timo1234!"
}

> {%
    client.test("로그인하면 access token 이 온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("token", response.body.accessToken);
%}

### 스윕 실행 - 기준 시각 지정
POST {{baseUrl}}/api/v1/dev/notifications/sweep?at=2026-09-20T09:00:00

> {%
    client.test("스윕이 끝난다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
%}

### 스윕 실행 - 지금 시각
POST {{baseUrl}}/api/v1/dev/notifications/sweep

### 안 읽은 알림 개수
GET {{baseUrl}}/api/v1/notifications/unread-count
Authorization: Bearer {{token}}

### 알림 목록
GET {{baseUrl}}/api/v1/notifications?size=20
Authorization: Bearer {{token}}
