###############################################################################
# 알림 세 종류를 한 흐름으로 확인한다 - 찜한 공연의 새 매물, 공연 2시간 전 입장 안내, 판매 완료
#
# local 프로필로 띄우고 우측 상단에서 env 를 local 로 고른다({{baseUrl}}). 앱을 새로 띄운 직후
# (시드가 새로 만들어진 상태) 한 번 위에서 아래로 돌린다. 스윕 트리거는 local 에만 있다(notification-dev.http).
#
# 회원 셋을 쓴다. 시드는 seed001~seed110 에게 공연 3(로이킴) 티켓을 한 장씩 주고, seed180 은 티켓이 없다.
#   찜한 사람  seed180  공연 3 을 찜한다. 티켓이 없어야 매물 알림을 받는다(보유자는 제외).
#   판매자     seed002  공연 3 티켓을 매물로 올린다. 자기 매물 알림은 받지 않는다.
#   구매자     seed001  그 매물을 산다. 판매자에게 판매 완료가 간다.
#
# 흐름: 로그인 셋 -> 찜 -> 매물 등록 -> [market-fixture.sql 로 등록 시각을 하루 당김]
#       -> 마켓 오픈 시각(오늘 08:00) 스윕 -> 찜한 사람 알림함 -> 같은 시각 재실행 0건
#       -> 공연 시작 2시간 전 스윕 -> 보유자 알림함 -> 구매 -> 판매자 알림함 -> 같은 매물 재구매 409
# 매물은 등록 다음 날 08:00 에 올라가므로 스윕도 "어제 등록된 매물" 만 본다. 오늘 등록한 매물로 오늘
# 알림을 보려면 fixture 로 등록 시각을 당기는 수밖에 없다. 구매는 마켓이 열린 08:00~23:00 에만 된다.
###############################################################################

### 로그인 - 찜한 사람 (seed180, 티켓 없음)
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 11111111-1111-1111-1111-111111111180
Content-Type: application/json

{
  "username": "seed180",
  "password": "timo1234!"
}

> {%
    client.test("로그인", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("wisherToken", response.body.accessToken);
%}

### 로그인 - 판매자 (seed002)
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 11111111-1111-1111-1111-111111111002
Content-Type: application/json

{
  "username": "seed002",
  "password": "timo1234!"
}

> {%
    client.test("로그인", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("sellerToken", response.body.accessToken);
%}

### 로그인 - 구매자 (seed001)
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 11111111-1111-1111-1111-111111111001
Content-Type: application/json

{
  "username": "seed001",
  "password": "timo1234!"
}

> {%
    client.test("로그인", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("buyerToken", response.body.accessToken);
%}

### 판매자의 티켓 - 공연 3(로이킴) 티켓과 공연 시작 시각을 챙긴다
GET {{baseUrl}}/api/v1/tickets/me?size=50
Authorization: Bearer {{sellerToken}}

> {%
    client.test("공연 3 티켓이 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var ticket = response.body.content.filter(function (t) { return t.concertId === 3; })[0];
        client.assert(ticket !== undefined, "seed002 에게 공연 3 티켓이 없다 - 시드가 바뀌었는지 본다");
        client.global.set("concertId", ticket.concertId);
        client.global.set("ticketToSell", ticket.ticketId);
        // 입장 안내는 공연 시작 2시간 전에 나간다. 그 시각을 스윕의 at 으로 쓴다.
        var start = new Date(ticket.startDate);
        start.setHours(start.getHours() - 2);
        var pad = function (n) { return (n < 10 ? "0" : "") + n; };
        client.global.set("entryOpenAt", start.getFullYear() + "-" + pad(start.getMonth() + 1) + "-" + pad(start.getDate())
                + "T" + pad(start.getHours()) + ":" + pad(start.getMinutes()) + ":00");
    });
%}

### 찜 - seed180 이 공연 3 을 찜한다 (204)
PUT {{baseUrl}}/api/v1/wishes/{{concertId}}
Authorization: Bearer {{wisherToken}}

> {%
    client.test("204", function () {
        client.assert(response.status === 204, "status: " + response.status);
    });
%}

### 매물 등록 - 판매자가 정가 이하로 올린다 (201)
POST {{baseUrl}}/api/v1/market/listings
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "ticketId": {{ticketToSell}},
  "price": 90000
}

> {%
    client.test("201 이고 LISTED 다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "LISTED", "status: " + response.body.status);
    });
    client.global.set("listingId", response.body.listingId);
    client.global.set("listedPrice", response.body.price);
    // 스윕은 "어제 등록된 매물" 을 보므로 오늘 08:00 이 알림 시각이다.
    client.global.set("marketOpenAt", new Date().toISOString().substring(0, 10) + "T08:00:00");
%}

### >>> 여기서 market-fixture.sql 을 실행해 등록 시각을 하루 당긴다. 안 당기면 아래 스윕이 0건이다 <<<
GET {{baseUrl}}/api/v1/market/listings/{{listingId}}
Authorization: Bearer {{sellerToken}}

> {%
    client.test("등록 시각이 어제 이전이다 - fixture 를 돌렸는가", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var listedAt = new Date(response.body.listedAt);
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        client.assert(listedAt < today, "listedAt 이 오늘이다: " + response.body.listedAt + " - market-fixture.sql 을 먼저 실행한다");
    });
%}

### 스윕 - 마켓 오픈 시각(오늘 08:00). 찜한 사람에게 새 매물 알림 1건
POST {{baseUrl}}/api/v1/dev/notifications/sweep?at={{marketOpenAt}}

> {%
    client.test("MARKET_NEW_LISTING 1건", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var sweep = response.body.sweeps.filter(function (s) { return s.name === "MARKET_NEW_LISTING"; })[0];
        client.assert(sweep.failed === false, "스윕이 실패했다");
        client.assert(sweep.recorded === 1, "recorded: " + sweep.recorded + " (찜한 사람 한 명이어야 한다)");
    });
%}

### 찜한 사람 알림함 - 공연이 하나라 공연 상세로 이동한다
GET {{baseUrl}}/api/v1/notifications?size=10
Authorization: Bearer {{wisherToken}}

> {%
    client.test("새 매물 알림이 있고 공연 상세로 간다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var n = response.body.items[0];
        client.assert(n.type === "MARKET_NEW_LISTING", "type: " + n.type);
        client.assert(n.linkType === "CONCERT", "linkType: " + n.linkType);
        client.assert(n.linkId === client.global.get("concertId"), "linkId: " + n.linkId);
        client.assert(n.read === false, "읽음 처리돼 있다");
        client.assert(n.body.indexOf("양도 매물이 올라왔어요") >= 0, "body: " + n.body);
    });
%}

### 판매자는 자기 매물 알림을 받지 않는다 - 안 읽은 알림 0
GET {{baseUrl}}/api/v1/notifications/unread-count
Authorization: Bearer {{sellerToken}}

> {%
    client.test("0", function () {
        client.assert(response.body.unreadCount === 0, "unreadCount: " + response.body.unreadCount);
    });
%}

### 같은 시각으로 다시 스윕 - 0건 (중복 방지)
POST {{baseUrl}}/api/v1/dev/notifications/sweep?at={{marketOpenAt}}

> {%
    client.test("MARKET_NEW_LISTING 0건", function () {
        var sweep = response.body.sweeps.filter(function (s) { return s.name === "MARKET_NEW_LISTING"; })[0];
        client.assert(sweep.recorded === 0, "recorded: " + sweep.recorded);
    });
%}

### 스윕 - 공연 시작 2시간 전. 공연 3 보유자 전원에게 입장 안내
POST {{baseUrl}}/api/v1/dev/notifications/sweep?at={{entryOpenAt}}

> {%
    client.test("ENTRY_OPEN 이 보유자 수만큼 나간다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var sweep = response.body.sweeps.filter(function (s) { return s.name === "ENTRY_OPEN"; })[0];
        client.assert(sweep.failed === false, "스윕이 실패했다");
        client.assert(sweep.recorded > 0, "recorded: " + sweep.recorded + " (시드 보유자 110명이면 110)");
    });
%}

### 보유자(구매자 seed001) 알림함 - 입장 안내가 있다
GET {{baseUrl}}/api/v1/notifications?size=10
Authorization: Bearer {{buyerToken}}

> {%
    client.test("ENTRY_OPEN", function () {
        var n = response.body.items[0];
        client.assert(n.type === "ENTRY_OPEN", "type: " + n.type);
        client.assert(n.linkType === "CONCERT" && n.linkId === client.global.get("concertId"), "link: " + n.linkType + " " + n.linkId);
        client.assert(n.body.indexOf("지금부터 입장할 수 있어요") >= 0, "body: " + n.body);
    });
%}

### 티켓이 없는 seed180 은 입장 안내를 받지 않는다 - 새 매물 1건 그대로
GET {{baseUrl}}/api/v1/notifications/unread-count
Authorization: Bearer {{wisherToken}}

> {%
    client.test("1", function () {
        client.assert(response.body.unreadCount === 1, "unreadCount: " + response.body.unreadCount);
    });
%}

### 구매 - 마켓이 열린 시간이어야 한다 (202)
POST {{baseUrl}}/api/v1/market/listings/{{listingId}}/purchase
Authorization: Bearer {{buyerToken}}
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{
  "expectedPrice": {{listedPrice}}
}

> {%
    client.test("202 PENDING", function () {
        client.assert(response.status === 202, "status: " + response.status + " (409 MARKET_CLOSED 면 08:00~23:00 에 다시)");
        client.assert(response.body.status === "PENDING", "status: " + response.body.status);
    });
    client.global.set("tradeId", response.body.tradeId);
%}

### 판매자 알림함 - 판매 완료가 맨 위에 있고 거래 상세로 간다
GET {{baseUrl}}/api/v1/notifications?size=10
Authorization: Bearer {{sellerToken}}

> {%
    client.test("LISTING_SOLD", function () {
        var n = response.body.items[0];
        client.assert(n.type === "LISTING_SOLD", "type: " + n.type);
        client.assert(n.linkType === "TRADE", "linkType: " + n.linkType);
        client.assert(n.linkId === client.global.get("tradeId"), "linkId: " + n.linkId);
        client.assert(n.body.indexOf("티켓이 판매됐어요") >= 0, "body: " + n.body);
    });
%}

### 구매자에게는 판매 완료가 없다 - 판매자와 구매자는 서로를 모른다
GET {{baseUrl}}/api/v1/notifications?size=10
Authorization: Bearer {{buyerToken}}

> {%
    client.test("LISTING_SOLD 없음", function () {
        var sold = response.body.items.filter(function (n) { return n.type === "LISTING_SOLD"; });
        client.assert(sold.length === 0, "구매자에게 판매 완료가 갔다");
    });
%}

### 같은 매물을 다시 사면 409 - 알림도 두 번 가지 않는다
POST {{baseUrl}}/api/v1/market/listings/{{listingId}}/purchase
Authorization: Bearer {{wisherToken}}
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{
  "expectedPrice": {{listedPrice}}
}

> {%
    client.test("409", function () {
        client.assert(response.status === 409, "status: " + response.status);
    });
%}

### 판매자 안 읽은 알림 - 입장 안내 1 + 판매 완료 1 = 2. 재구매로 늘지 않았다
GET {{baseUrl}}/api/v1/notifications/unread-count
Authorization: Bearer {{sellerToken}}

> {%
    client.test("2", function () {
        client.assert(response.body.unreadCount === 2, "unreadCount: " + response.body.unreadCount);
    });
%}
