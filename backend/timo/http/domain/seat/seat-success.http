###############################################################################
# 좌석 등록 - 성공 케이스
#
# seat-common.http 를 먼저 실행해 {{seatVenueId}} 를 채워 둬야 한다.
# 그 뒤로는 이 파일만 몇 번이든 다시 돌려도 된다. 아래 헬스 체크가 실행마다 새 접미사를
# 뽑아 구역명에 붙이므로 uk_section_venue_name 에 걸리지 않는다.
#
# 좌석은 seats 에 자리를 나열해서만 등록된다. 실제 공연장은 통로로 비는 자리나 행마다
# 다른 좌석 수가 흔해서 격자로 찍어내는 방식으로는 표현되지 않기 때문이다.
#
# rowCount / seatPerRow 는 배치도를 그릴 때 쓰는 격자 크기이고 선택값이다. 생략하면
# 좌석 목록의 최대 번호에서 뽑아내고, 함께 보내면 그 값이 유지되면서 범위 검사 기준이 된다.
#
# seatCount 와 grade 는 요청으로 받지 않는다. 좌석 수는 실제로 만들어진 개수로,
# 등급은 등급 구분이 생기기 전이라 COMMON 으로 서버가 채운다.
###############################################################################

### 이번 실행의 구역명 접미사를 뽑는다
GET {{baseUrl}}/actuator/health

> {%
    client.test("애플리케이션이 살아 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });

    client.global.set("sectionSuffix", Math.floor(Math.random() * 900000) + 100000);
%}

### 좌석을 나열해 등록한다 - 2행 2번 자리가 통로로 비어 있는 배치
POST {{baseUrl}}/api/v1/seats
Content-Type: application/json

{
  "venueId": {{seatVenueId}},
  "sections": [
    {
      "name": "1층 A블록-{{sectionSuffix}}",
      "price": 150000,
      "seats": [
        { "seatNo": 1, "seatCol": 1 },
        { "seatNo": 1, "seatCol": 2 },
        { "seatNo": 1, "seatCol": 3 },
        { "seatNo": 2, "seatCol": 1 },
        { "seatNo": 2, "seatCol": 3 }
      ]
    }
  ]
}

> {%
    // 실패했을 때 단정 실패 위에 TypeError 가 겹치지 않도록 없는 필드는 빈 객체로 받는다.
    const section = (response.body.sections || [])[0] || {};

    client.test("201 로 구역이 만들어진다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(section.id !== undefined, "구역 id 가 비어 있다: " + JSON.stringify(response.body));
    });

    client.test("격자를 채우지 않고 나열한 5석만 등록된다", function () {
        client.assert(section.seatCount === 5, "seatCount: " + section.seatCount);
        client.assert(response.body.totalSeatCount === 5,
            "totalSeatCount: " + response.body.totalSeatCount);
    });

    client.test("배치도 격자 크기는 좌석의 최대 번호에서 뽑아낸다", function () {
        // 격자 크기는 2 x 3 = 6 이지만 실제 좌석은 5석이다.
        client.assert(section.rowCount === 2, "rowCount: " + section.rowCount);
        client.assert(section.seatPerRow === 3, "seatPerRow: " + section.seatPerRow);
    });

    client.test("등급과 가격은 구역 단위로 정해진다", function () {
        client.assert(section.grade === "COMMON", "grade: " + section.grade);
        client.assert(section.price === 150000, "price: " + section.price);
    });

    client.test("공연장 정보가 함께 내려온다", function () {
        client.assert(response.body.venueName === client.global.get("seatVenueName"),
            "venueName: " + response.body.venueName);
    });

    client.global.set("sectionId", section.id);
%}

### 행마다 좌석 수가 다른 배치도 그대로 등록된다
# 1행 4석, 2행 3석, 3행 2석. 무대에 가까워질수록 좁아지는 구역 모양이다.
POST {{baseUrl}}/api/v1/seats
Content-Type: application/json

{
  "venueId": {{seatVenueId}},
  "sections": [
    {
      "name": "1층 B블록-{{sectionSuffix}}",
      "price": 130000,
      "seats": [
        { "seatNo": 1, "seatCol": 1 },
        { "seatNo": 1, "seatCol": 2 },
        { "seatNo": 1, "seatCol": 3 },
        { "seatNo": 1, "seatCol": 4 },
        { "seatNo": 2, "seatCol": 1 },
        { "seatNo": 2, "seatCol": 2 },
        { "seatNo": 2, "seatCol": 3 },
        { "seatNo": 3, "seatCol": 1 },
        { "seatNo": 3, "seatCol": 2 }
      ]
    }
  ]
}

> {%
    const section = (response.body.sections || [])[0] || {};

    client.test("9석이 등록된다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(section.seatCount === 9, "seatCount: " + section.seatCount);
    });

    client.test("격자 크기는 가장 긴 행을 기준으로 잡힌다", function () {
        // 3 x 4 = 12 자리 중 9석만 실제로 존재한다.
        client.assert(section.rowCount === 3, "rowCount: " + section.rowCount);
        client.assert(section.seatPerRow === 4, "seatPerRow: " + section.seatPerRow);
    });
%}

### 배치도 격자 크기를 직접 보낸다 - 좌석이 격자 끝까지 닿지 않는 구역
POST {{baseUrl}}/api/v1/seats
Content-Type: application/json

{
  "venueId": {{seatVenueId}},
  "sections": [
    {
      "name": "2층 A블록-{{sectionSuffix}}",
      "price": 99000,
      "rowCount": 10,
      "seatPerRow": 20,
      "seats": [
        { "seatNo": 1, "seatCol": 5 },
        { "seatNo": 1, "seatCol": 6 },
        { "seatNo": 9, "seatCol": 18 }
      ]
    }
  ]
}

> {%
    const section = (response.body.sections || [])[0] || {};

    client.test("보낸 격자 크기는 유도값으로 덮이지 않는다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        // 좌석의 최대 번호는 9 x 18 이지만 선언한 10 x 20 이 유지된다.
        client.assert(section.rowCount === 10, "rowCount: " + section.rowCount);
        client.assert(section.seatPerRow === 20, "seatPerRow: " + section.seatPerRow);
    });

    client.test("좌석 수는 격자 크기가 아니라 나열한 개수다", function () {
        client.assert(section.seatCount === 3, "seatCount: " + section.seatCount);
    });
%}

### 구역 여러 개를 한 번에 등록한다
POST {{baseUrl}}/api/v1/seats
Content-Type: application/json

{
  "venueId": {{seatVenueId}},
  "sections": [
    {
      "name": "3층 A블록-{{sectionSuffix}}",
      "price": 70000,
      "seats": [
        { "seatNo": 1, "seatCol": 1 },
        { "seatNo": 1, "seatCol": 2 },
        { "seatNo": 2, "seatCol": 1 }
      ]
    },
    {
      "name": "3층 B블록-{{sectionSuffix}}",
      "price": 50000,
      "seats": [
        { "seatNo": 1, "seatCol": 1 },
        { "seatNo": 1, "seatCol": 2 }
      ]
    }
  ]
}

> {%
    const sections = response.body.sections || [];

    client.test("구역 2개가 한 번에 만들어진다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(sections.length === 2, "sections: " + JSON.stringify(response.body));
    });

    client.test("전체 좌석 수는 구역별 좌석 수의 합이다", function () {
        client.assert((sections[0] || {}).seatCount === 3,
            "3층 A블록 seatCount: " + (sections[0] || {}).seatCount);
        client.assert((sections[1] || {}).seatCount === 2,
            "3층 B블록 seatCount: " + (sections[1] || {}).seatCount);
        client.assert(response.body.totalSeatCount === 5,
            "totalSeatCount: " + response.body.totalSeatCount);
    });

    client.test("보낸 순서대로 내려온다", function () {
        const first = (sections[0] || {}).name || "";
        const second = (sections[1] || {}).name || "";
        client.assert(first.startsWith("3층 A블록"), "첫 번째 구역: " + first);
        client.assert(second.startsWith("3층 B블록"), "두 번째 구역: " + second);
    });
%}

### 공연장의 구역 목록을 조회한다 - 좌석 고르기 전 구역 선택 화면이 쓴다
GET {{baseUrl}}/api/v1/sections?venueId={{seatVenueId}}

> {%
    const sections = response.body.sections || [];

    client.test("200 과 함께 이 공연장의 구역이 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.venueId === Number(client.global.get("seatVenueId")),
            "venueId: " + response.body.venueId);
        client.assert(sections.length >= 1, "sections: " + sections.length);
    });

    client.test("앞서 등록한 5석 구역이 잔여석과 함께 담긴다", function () {
        const target = sections.filter(x => x.id === Number(client.global.get("sectionId")))[0] || {};
        client.assert(target.seatCount === 5, "seatCount: " + target.seatCount);
        client.assert(target.availableCount === 5, "availableCount: " + target.availableCount);
        client.assert(target.grade === "COMMON", "grade: " + target.grade);
        client.assert(target.price === 150000, "price: " + target.price);
    });

    client.test("구역 목록에는 개별 좌석을 담지 않는다", function () {
        client.assert(sections[0].seats === undefined, "seats 가 구역 목록에 들어 있다");
    });

    client.test("전체 좌석 수와 잔여석 합계가 함께 내려온다", function () {
        const sum = sections.reduce((acc, x) => acc + x.seatCount, 0);
        client.assert(response.body.totalSeatCount === sum,
            "totalSeatCount: " + response.body.totalSeatCount + " vs " + sum);
        client.assert(response.body.totalAvailableCount === sum,
            "아직 판매 전이라 잔여석은 전체와 같아야 한다: " + response.body.totalAvailableCount);
    });
%}

### 구역 하나의 좌석을 조회한다 - 배치도를 그리는 화면이 쓴다
GET {{baseUrl}}/api/v1/seats?sectionId={{sectionId}}

> {%
    const seats = response.body.seats || [];

    client.test("200 과 함께 그 구역의 좌석만 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.sectionId === Number(client.global.get("sectionId")),
            "sectionId: " + response.body.sectionId);
        client.assert(seats.length === 5, "seats: " + seats.length);
    });

    client.test("등급·가격·격자는 좌석마다가 아니라 응답 머리에 한 번만 담긴다", function () {
        client.assert(response.body.grade === "COMMON", "grade: " + response.body.grade);
        client.assert(response.body.price === 150000, "price: " + response.body.price);
        client.assert(response.body.rowCount === 2, "rowCount: " + response.body.rowCount);
        client.assert(response.body.seatPerRow === 3, "seatPerRow: " + response.body.seatPerRow);
        client.assert(seats[0].grade === undefined, "좌석에 grade 가 중복해서 들어 있다");
        client.assert(seats[0].price === undefined, "좌석에 price 가 중복해서 들어 있다");
    });

    client.test("좌석은 배치도 순서(행 -> 자리)로 내려온다", function () {
        const order = seats.map(x => x.seatNo + "-" + x.seatCol).join(",");
        client.assert(order === "1-1,1-2,1-3,2-1,2-3", "순서: " + order);
    });

    client.test("통로로 비운 2행 2번 자리는 목록에 없다", function () {
        const gap = seats.filter(x => x.seatNo === 2 && x.seatCol === 2);
        client.assert(gap.length === 0, "빈 자리가 좌석으로 내려왔다");
    });

    client.test("좌석마다 상태가 담기고 잔여석이 함께 계산된다", function () {
        client.assert(seats[0].status === "AVAILABLE", "status: " + seats[0].status);
        client.assert(response.body.seatCount === 5, "seatCount: " + response.body.seatCount);
        client.assert(response.body.availableCount === 5,
            "availableCount: " + response.body.availableCount);
    });

    // 선점 요청에서 쓴다.
    client.global.set("seatId", seats[0].id);
    client.global.set("otherSeatId", seats[1].id);
%}

### 좌석을 선점한다 - 인증 전이라 X-Member-Id 헤더로 요청자를 흉내 낸다
POST {{baseUrl}}/api/v1/seats/{{seatId}}/hold
X-Member-Id: 1

> {%
    client.test("200 과 함께 만료 시각을 알려준다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.seatId === Number(client.global.get("seatId")),
            "seatId: " + response.body.seatId);
        client.assert(response.body.status === "RESERVED", "status: " + response.body.status);
        client.assert(response.body.heldUntil !== null, "heldUntil 이 비어 있다");
    });

    client.test("만료는 지금부터 5분 뒤다", function () {
        const remainMs = new Date(response.body.heldUntil).getTime() - Date.now();
        client.assert(remainMs > 4 * 60 * 1000 && remainMs <= 5 * 60 * 1000 + 30 * 1000,
            "남은 시간(ms): " + remainMs);
    });

    client.test("첫 선점이라 풀린 좌석은 없다", function () {
        client.assert(response.body.releasedSeatId === null,
            "releasedSeatId: " + response.body.releasedSeatId);
    });

    client.test("선점한 회원 id 는 응답에 담지 않는다", function () {
        client.assert(response.body.heldByMemberId === undefined, "선점자가 노출됐다");
    });
%}

### 선점한 좌석은 목록에서 RESERVED 로 보이고 잔여석에서 빠진다
GET {{baseUrl}}/api/v1/seats?sectionId={{sectionId}}

> {%
    const held = (response.body.seats || [])
        .filter(x => x.id === Number(client.global.get("seatId")))[0] || {};

    client.test("선점이 좌석 목록에 반영된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(held.status === "RESERVED", "status: " + held.status);
        client.assert(response.body.availableCount === 4,
            "availableCount: " + response.body.availableCount);
    });
%}

### 같은 회원이 다른 좌석을 선점하면 이전 선점이 풀린다 (한 계정 동시 하나)
POST {{baseUrl}}/api/v1/seats/{{otherSeatId}}/hold
X-Member-Id: 1

> {%
    client.test("새 좌석이 잡히고 이전 좌석이 풀렸다고 알려준다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.seatId === Number(client.global.get("otherSeatId")),
            "seatId: " + response.body.seatId);
        client.assert(response.body.releasedSeatId === Number(client.global.get("seatId")),
            "releasedSeatId: " + response.body.releasedSeatId);
    });
%}

### 이미 내가 잡은 좌석을 다시 누르면 만료만 미뤄진다
POST {{baseUrl}}/api/v1/seats/{{otherSeatId}}/hold
X-Member-Id: 1

> {%
    client.test("409 가 아니라 200 으로 갱신된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.releasedSeatId === null,
            "내 좌석을 내가 다시 잡는 것이라 풀릴 자리가 없다: " + response.body.releasedSeatId);
    });
%}

### 풀린 좌석은 다시 예매 가능이다
GET {{baseUrl}}/api/v1/seats?sectionId={{sectionId}}

> {%
    const released = (response.body.seats || [])
        .filter(x => x.id === Number(client.global.get("seatId")))[0] || {};

    client.test("이전에 잡았던 좌석이 AVAILABLE 로 돌아왔다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(released.status === "AVAILABLE", "status: " + released.status);
    });
%}

### 내가 잡고 있는 좌석의 선점을 취소한다
DELETE {{baseUrl}}/api/v1/seats/{{otherSeatId}}/hold
X-Member-Id: 1

> {%
    client.test("200 과 함께 풀린 좌석 정보를 알려준다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.seatId === Number(client.global.get("otherSeatId")),
            "seatId: " + response.body.seatId);
        client.assert(response.body.sectionId === Number(client.global.get("sectionId")),
            "sectionId: " + response.body.sectionId);
        client.assert(response.body.status === "AVAILABLE", "status: " + response.body.status);
    });

    client.test("만료 시각과 풀린 좌석 id 는 취소 응답에 없다", function () {
        client.assert(response.body.heldUntil === undefined, "heldUntil 이 내려왔다");
        client.assert(response.body.releasedSeatId === undefined, "releasedSeatId 가 내려왔다");
        client.assert(response.body.heldByMemberId === undefined, "선점자가 노출됐다");
    });
%}

### 취소한 좌석은 목록에서 AVAILABLE 로 보이고 잔여석에 다시 포함된다
GET {{baseUrl}}/api/v1/seats?sectionId={{sectionId}}

> {%
    const cancelled = (response.body.seats || [])
        .filter(x => x.id === Number(client.global.get("otherSeatId")))[0] || {};

    client.test("취소가 좌석 목록에 반영된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(cancelled.status === "AVAILABLE", "status: " + cancelled.status);
        client.assert(response.body.availableCount === 5,
            "availableCount: " + response.body.availableCount);
    });
%}

### 이미 빈 좌석을 다시 취소해도 200 - 취소는 멱등하다
DELETE {{baseUrl}}/api/v1/seats/{{otherSeatId}}/hold
X-Member-Id: 1

> {%
    client.test("오류 없이 같은 본문으로 답한다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "AVAILABLE", "status: " + response.body.status);
    });
%}

### 취소한 좌석은 다른 회원이 바로 선점할 수 있다
POST {{baseUrl}}/api/v1/seats/{{otherSeatId}}/hold
X-Member-Id: 2

> {%
    client.test("풀린 자리를 2번 회원이 잡는다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "RESERVED", "status: " + response.body.status);
    });
%}

### 뒷정리 - 2번 회원이 잡은 선점을 풀어 다음 실행에 영향을 주지 않는다
DELETE {{baseUrl}}/api/v1/seats/{{otherSeatId}}/hold
X-Member-Id: 2

> {%
    client.test("뒷정리 취소가 성공한다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
%}

### 점유 준비 - 1번 회원이 좌석을 다시 선점한다
# 점유(결제 확정)는 유효한 내 선점 위에서만 성립한다.
POST {{baseUrl}}/api/v1/seats/{{seatId}}/hold
X-Member-Id: 1

> {%
    client.test("점유용 선점이 성공한다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "RESERVED", "status: " + response.body.status);
    });
%}

### 선점한 좌석을 점유한다 - 결제 확정을 흉내 내는 임시 API
POST {{baseUrl}}/api/v1/seats/{{seatId}}/occupancy
X-Member-Id: 1

> {%
    client.test("200 과 함께 OCCUPIED 좌석 정보를 알려준다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.seatId === Number(client.global.get("seatId")),
            "seatId: " + response.body.seatId);
        client.assert(response.body.sectionId === Number(client.global.get("sectionId")),
            "sectionId: " + response.body.sectionId);
        client.assert(response.body.status === "OCCUPIED", "status: " + response.body.status);
    });

    client.test("점유에는 만료가 없어 만료 시각을 싣지 않는다", function () {
        client.assert(response.body.heldUntil === undefined, "heldUntil 이 내려왔다");
        client.assert(response.body.releasedSeatId === undefined, "releasedSeatId 가 내려왔다");
        client.assert(response.body.heldByMemberId === undefined, "소유자가 노출됐다");
    });
%}

### 점유한 좌석은 목록에서 OCCUPIED 로 보이고 잔여석에서 빠진다
GET {{baseUrl}}/api/v1/seats?sectionId={{sectionId}}

> {%
    const occupied = (response.body.seats || [])
        .filter(x => x.id === Number(client.global.get("seatId")))[0] || {};

    client.test("점유가 좌석 목록에 반영된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(occupied.status === "OCCUPIED", "status: " + occupied.status);
        client.assert(response.body.availableCount === 4,
            "availableCount: " + response.body.availableCount);
    });
%}

### 점유한 좌석은 다른 회원이 선점할 수 없다 - 만료 개념이 없다
POST {{baseUrl}}/api/v1/seats/{{seatId}}/hold
X-Member-Id: 2

> {%
    client.test("409 로 거절된다", function () {
        client.assert(response.status === 409, "status: " + response.status);
        client.assert(response.body.exception === "SeatNotHoldableException",
            "exception: " + response.body.exception);
    });
%}

### 이미 내가 점유한 좌석을 다시 점유해도 200 - 점유는 멱등하다
POST {{baseUrl}}/api/v1/seats/{{seatId}}/occupancy
X-Member-Id: 1

> {%
    client.test("오류 없이 같은 본문으로 답한다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "OCCUPIED", "status: " + response.body.status);
    });
%}

### 점유를 해제한다 - 예매 취소를 흉내 내는 임시 API
DELETE {{baseUrl}}/api/v1/seats/{{seatId}}/occupancy
X-Member-Id: 1

> {%
    client.test("200 과 함께 AVAILABLE 좌석 정보를 알려준다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.seatId === Number(client.global.get("seatId")),
            "seatId: " + response.body.seatId);
        client.assert(response.body.status === "AVAILABLE", "status: " + response.body.status);
        client.assert(response.body.heldByMemberId === undefined, "소유자가 노출됐다");
    });
%}

### 해제한 좌석은 목록에서 AVAILABLE 로 보이고 잔여석에 다시 포함된다
GET {{baseUrl}}/api/v1/seats?sectionId={{sectionId}}

> {%
    const released = (response.body.seats || [])
        .filter(x => x.id === Number(client.global.get("seatId")))[0] || {};

    client.test("해제가 좌석 목록에 반영된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(released.status === "AVAILABLE", "status: " + released.status);
        client.assert(response.body.availableCount === 5,
            "availableCount: " + response.body.availableCount);
    });
%}

### 이미 빈 좌석을 다시 해제해도 200 - 해제는 멱등하다
DELETE {{baseUrl}}/api/v1/seats/{{seatId}}/occupancy
X-Member-Id: 1

> {%
    client.test("오류 없이 같은 본문으로 답한다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "AVAILABLE", "status: " + response.body.status);
    });
%}
