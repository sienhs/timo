###############################################################################
# 공연 API 공통 준비
#
# 실행 순서: concert-common.http -> concert-success.http -> concert-fail.http
#
# 이 파일은 공연 생성에 필요한 선행 데이터를 만들고, 만들어진 식별자를
# client.global 에 담아 둔다. 같은 실행 세션 안에서는 다른 .http 파일에서도
# {{venueId}} 로 꺼내 쓸 수 있다.
#
# 환경 변수는 프로젝트 루트의 http-client.env.json 에 있는 local 을 쓴다.
# IntelliJ 는 env 파일을 .http 파일과 같은 디렉터리 또는 프로젝트 루트에서만 찾는다.
# 도메인이 늘어도 하나만 두려고 루트(backend/timo)에 뒀다.
# 실행 전에 우측 상단 드롭다운에서 local 을 선택해야 {{baseUrl}} 이 치환된다.
#
# [사전 조건] 아티스트는 아직 등록 API 가 없지만 수동 INSERT 는 필요 없다.
#   ddl-auto 가 create-drop 이라 기동마다 스키마가 새로 생기고, 그 뒤에
#   db/seed-local.sql 이 자동으로 실행돼 artist_id 1, 2 가 채워진다.
#   (application-local.yml 의 spring.sql.init 설정, 자세한 내용은
#    backend/docs/BE_HTTP_CLIENT_TROUBLESHOOTING.md 3장)
###############################################################################

### 헬스 체크 - 애플리케이션이 떠 있는지 먼저 확인한다
GET {{baseUrl}}/actuator/health

> {%
    client.test("애플리케이션이 살아 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "UP", "health: " + response.body.status);
    });
%}

### 공연장 등록 - 공연은 공연장이 있어야 만들 수 있다
POST {{baseUrl}}/api/v1/venues
Content-Type: application/json

{
  "name": "고척돔",
  "address": "서울시 구로구 경인로 430",
  "totalSeatCount": 16000
}

> {%
    client.test("201 로 공연장이 만들어진다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.id !== null, "id 가 비어 있다");
    });
    // 이후 파일에서 {{venueId}} 로 참조한다.
    client.global.set("venueId", response.body.id);
%}
