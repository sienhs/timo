###############################################################################
# 공연 생성·조회 - 성공 케이스
#
# concert-common.http 를 먼저 실행해 {{venueId}} 를 채워 둬야 한다.
# 조회 요청은 이 파일 첫 번째 생성 요청이 채워 둔 {{concertId}} 를 그대로 쓴다.
###############################################################################

### 모든 필드를 채워 공연을 생성한다
POST {{baseUrl}}/api/v1/concerts
Content-Type: application/json

{
  "title": "아이유 HEREH WORLD TOUR",
  "genre": "CONCERT",
  "posterImageKey": "concert/poster/iu-2026.png",
  "imageKeys": [
    "concert/detail/iu-1.png",
    "concert/detail/iu-2.png"
  ],
  "description": "2026 아이유 월드투어 서울 공연",
  "ageRating": "AGE_7",
  "startDate": "2026-04-10T19:00:00",
  "endDate": "2026-04-12T21:00:00",
  "openAt": "2026-03-01T20:00:00",
  "venueId": {{venueId}},
  "artistIds": [{{artistId1}}, {{artistId2}}]
}

> {%
    client.test("201 과 Location 헤더를 반환한다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.headers.valueOf("Location") === "/api/v1/concerts/" + response.body.id,
            "Location: " + response.headers.valueOf("Location"));
    });

    client.test("상태와 조회수는 서버가 정한다", function () {
        client.assert(response.body.status === "SCHEDULED", "status: " + response.body.status);
        client.assert(response.body.viewCount === 0, "viewCount: " + response.body.viewCount);
    });

    client.test("이미지 key 가 URL 로 변환돼 요청 순서대로 담긴다", function () {
        client.assert(response.body.imageUrls.length === 2, "imageUrls: " + response.body.imageUrls.length);
        client.assert(response.body.imageUrls[0].endsWith("concert/detail/iu-1.png"),
            "첫 번째 이미지: " + response.body.imageUrls[0]);
        client.assert(response.body.imageUrls[1].endsWith("concert/detail/iu-2.png"),
            "두 번째 이미지: " + response.body.imageUrls[1]);
        client.assert(response.body.posterImageUrl.endsWith("concert/poster/iu-2026.png"),
            "포스터: " + response.body.posterImageUrl);
    });

    client.test("출연 아티스트 두 명이 함께 내려온다", function () {
        client.assert(response.body.artists.length === 2, "artists: " + response.body.artists.length);
        client.assert(response.body.artists[0].name, "첫 번째 아티스트 이름이 비어 있다");
        client.assert(response.body.artists[1].name, "두 번째 아티스트 이름이 비어 있다");
    });

    client.test("공연장 정보가 함께 내려온다", function () {
        client.assert(response.body.venueName === "고척돔", "venueName: " + response.body.venueName);
    });

    client.global.set("concertId", response.body.id);
%}

### 선택값 없이 최소 필드만으로 생성한다
POST {{baseUrl}}/api/v1/concerts
Content-Type: application/json

{
  "title": "소극장 단독 공연",
  "genre": "PLAY",
  "ageRating": "ALL",
  "venueId": {{venueId}},
  "artistIds": [{{artistId1}}]
}

> {%
    client.test("일정과 이미지가 없어도 생성된다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.startDate === null, "startDate: " + response.body.startDate);
        client.assert(response.body.endDate === null, "endDate: " + response.body.endDate);
        client.assert(response.body.openAt === null, "openAt: " + response.body.openAt);
        client.assert(response.body.posterImageUrl === null, "posterImageUrl: " + response.body.posterImageUrl);
        client.assert(response.body.imageUrls.length === 0, "imageUrls: " + response.body.imageUrls.length);
    });
%}

### 같은 아티스트를 여러 번 넣으면 한 명으로 합쳐진다
POST {{baseUrl}}/api/v1/concerts
Content-Type: application/json

{
  "title": "중복 아티스트 확인용 공연",
  "genre": "FESTIVAL",
  "ageRating": "AGE_12",
  "venueId": {{venueId}},
  "artistIds": [{{artistId1}}, {{artistId1}}, {{artistId1}}]
}

> {%
    client.test("중복이 제거돼 한 명만 등록된다", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.artists.length === 1, "artists: " + response.body.artists.length);
    });
%}

### 방금 생성한 공연을 조회한다 (앞의 첫 번째 요청이 {{concertId}} 를 채워 둔다)
GET {{baseUrl}}/api/v1/concerts/{{concertId}}

> {%
    client.test("200 과 함께 공연장·아티스트·이미지까지 담긴 상세가 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.id === Number(client.global.get("concertId")), "id: " + response.body.id);
        client.assert(response.body.title === "아이유 HEREH WORLD TOUR", "title: " + response.body.title);
        client.assert(response.body.venueName === "고척돔", "venueName: " + response.body.venueName);
        client.assert(response.body.artists.length === 2, "artists: " + response.body.artists.length);
        client.assert(response.body.imageUrls.length === 2, "imageUrls: " + response.body.imageUrls.length);
    });

    client.test("조회수가 1 증가했다", function () {
        client.assert(response.body.viewCount === 1, "viewCount: " + response.body.viewCount);
    });
%}

### 조회할 때마다 조회수가 1씩 더 오른다
GET {{baseUrl}}/api/v1/concerts/{{concertId}}

> {%
    client.test("두 번째 조회라 조회수가 2 다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.viewCount === 2, "viewCount: " + response.body.viewCount);
    });
%}

### 공연 목록을 조회한다 - 조건을 주지 않으면 최근 등록순 첫 페이지
GET {{baseUrl}}/api/v1/concerts

> {%
    client.test("200 과 페이지 정보가 함께 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.page.number === 0, "number: " + response.body.page.number);
        client.assert(response.body.page.size === 20, "size: " + response.body.page.size);
        client.assert(response.body.page.totalElements >= 3,
            "totalElements: " + response.body.page.totalElements);
    });

    client.test("Page 를 그대로 직렬화할 때 새어 나오는 내부 필드가 없다", function () {
        client.assert(response.body.pageable === undefined, "pageable 이 노출됐다");
        client.assert(response.body.sort === undefined, "sort 가 노출됐다");
        client.assert(response.body.first === undefined, "first 는 PagedModel 에 없다");
        client.assert(response.body.last === undefined, "last 는 PagedModel 에 없다");
    });

    client.test("가장 마지막에 만든 공연이 맨 앞에 온다", function () {
        client.assert(response.body.content[0].title === "중복 아티스트 확인용 공연",
            "첫 번째: " + response.body.content[0].title);
    });

    client.test("카드에 필요한 필드가 채워져 있다", function () {
        const item = response.body.content[0];
        client.assert(item.id !== undefined, "id 가 없다");
        client.assert(item.venueName === "고척돔", "venueName: " + item.venueName);
        client.assert(item.status !== undefined, "status 가 없다");
    });

    client.test("목록에는 아티스트와 상세 이미지를 담지 않는다", function () {
        const item = response.body.content[0];
        client.assert(item.artists === undefined, "artists 가 목록에 들어 있다");
        client.assert(item.imageUrls === undefined, "imageUrls 가 목록에 들어 있다");
    });
%}

### 페이지 크기를 지정한다
GET {{baseUrl}}/api/v1/concerts?page=0&size=2

> {%
    client.test("요청한 크기만큼만 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.content.length === 2,
            "content: " + response.body.content.length);
        client.assert(response.body.page.size === 2, "size: " + response.body.page.size);
        client.assert(response.body.page.totalPages >= 2,
            "totalPages: " + response.body.page.totalPages);
    });
%}

### 조회수 많은 순으로 정렬한다 - 앞에서 두 번 조회한 공연이 맨 앞에 온다
GET {{baseUrl}}/api/v1/concerts?sort=POPULAR

> {%
    client.test("조회수가 가장 높은 공연이 먼저 나온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.content[0].title === "아이유 HEREH WORLD TOUR",
            "첫 번째: " + response.body.content[0].title);
        client.assert(response.body.content[0].viewCount >= 2,
            "viewCount: " + response.body.content[0].viewCount);
    });
%}

### 예매 오픈이 이른 순으로 정렬한다 - 오픈 미정인 공연은 뒤로 간다
GET {{baseUrl}}/api/v1/concerts?sort=OPEN_SOON

> {%
    client.test("오픈 일시가 있는 공연이 미정인 공연보다 앞에 온다", function () {
        client.assert(response.status === 200, "status: " + response.status);

        const openAts = response.body.content.map(c => c.openAt);
        const lastWithValue = openAts.reduce(function (acc, v, i) {
            return v !== null ? i : acc;
        }, -1);
        const firstWithoutValue = openAts.indexOf(null);

        client.assert(firstWithoutValue === -1 || firstWithoutValue > lastWithValue,
            "오픈 미정이 앞에 있다: " + JSON.stringify(openAts));
    });
%}

### 장르로 필터한다
GET {{baseUrl}}/api/v1/concerts?genre=PLAY

> {%
    client.test("해당 장르만 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.content.length >= 1,
            "content: " + response.body.content.length);
        response.body.content.forEach(function (c) {
            client.assert(c.genre === "PLAY", "genre: " + c.genre);
        });
    });
%}

### 공연명으로 검색한다 - 부분 일치
GET {{baseUrl}}/api/v1/concerts?keyword=아이유

> {%
    client.test("공연명에 검색어가 들어간 공연만 내려온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.content.length >= 1,
            "content: " + response.body.content.length);
        response.body.content.forEach(function (c) {
            client.assert(c.title.indexOf("아이유") >= 0, "title: " + c.title);
        });
    });
%}

### 조건에 맞는 공연이 없어도 200 과 빈 목록을 준다
GET {{baseUrl}}/api/v1/concerts?keyword=존재하지않는공연명

> {%
    client.test("빈 목록은 오류가 아니다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.content.length === 0,
            "content: " + response.body.content.length);
        client.assert(response.body.page.totalElements === 0,
            "totalElements: " + response.body.page.totalElements);
    });
%}
