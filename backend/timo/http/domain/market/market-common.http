###############################################################################
# 양도 마켓 API 공통 준비
#
# 실행 순서: market-common.http -> market-success.http -> market-fail.http
# local 프로필로 띄우고 우측 상단에서 env 를 local 로 고른다({{baseUrl}}).
#
# 마켓은 매일 20:00:00~23:59:59 에만 열린다(application.yml 의 market.hours).
# success 는 열린 시간에, fail 은 닫힌 시간에 돌린다. 시간을 기다리기 싫으면
# application-local.yml 에 market.hours 를 덮어쓰고 다시 띄운다 - 판정은 서버
# 시계라 IDE 나 기기 시계를 바꿔도 소용없다(그것이 이 기능의 존재 이유다).
#
# 요청자는 반드시 access token 이다. @CurrentMember 가 SecurityContext 의 JWT 에서
# sub 를 꺼내므로 X-Device-Id 나 X-Member-Id 헤더로는 대신할 수 없다.
###############################################################################

### 헬스 체크
GET {{baseUrl}}/actuator/health

> {%
    client.test("애플리케이션이 살아 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
%}

### 판매자 로그인 - 기기마다 세션이 하나라 구매자와 다른 X-Device-Id 를 쓴다
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 11111111-1111-1111-1111-111111111111
Content-Type: application/json

{
  "username": "seed001",
  "password": "timo1234!"
}

> {%
    client.test("로그인하면 access token 이 온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.accessToken !== undefined, "accessToken 이 없다");
    });
    client.global.set("sellerToken", response.body.accessToken);
%}

### 구매자 로그인
POST {{baseUrl}}/api/v1/auth/login
X-Device-Id: 22222222-2222-2222-2222-222222222222
Content-Type: application/json

{
  "username": "seed002",
  "password": "timo1234!"
}

> {%
    client.test("로그인하면 access token 이 온다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });
    client.global.set("buyerToken", response.body.accessToken);
%}

### 운영 시간 - 지금 열려 있는지와 창의 시각. 앱은 이 값으로 화면을 잠그되 판정은 서버가 한다
GET {{baseUrl}}/api/v1/market/hours
Authorization: Bearer {{sellerToken}}

> {%
    client.test("200 이고 네 필드가 다 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(typeof response.body.open === "boolean", "open: " + response.body.open);
        client.assert(response.body.serverTime !== undefined, "serverTime 이 없다");
        client.assert(response.body.opensAt !== undefined, "opensAt 이 없다");
        client.assert(response.body.closesAt !== undefined, "closesAt 이 없다");
    });
    client.global.set("marketOpen", response.body.open);
    client.log("마켓 " + (response.body.open ? "열림" : "닫힘") + ", 서버 시각 " + response.body.serverTime
            + ", 창 " + response.body.opensAt + " ~ " + response.body.closesAt);
%}

### 판매자가 등록할 티켓을 두 장 잡아 둔다 - 하나는 success 에서 팔고, 하나는 fail 에 넘긴다
GET {{baseUrl}}/api/v1/tickets/me?size=100
Authorization: Bearer {{sellerToken}}

> {%
    client.test("보유 목록이 PagedModel 모양이다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.page !== undefined, "page 가 없다");
    });

    var free = response.body.content.filter(function (t) {
        return t.listed === false && t.ticketStatus === "OWNED";
    });
    client.assert(free.length >= 2, "등록 가능한 티켓이 2장 미만이다 - 앱을 새로 띄워 시드를 다시 만든다");
    client.global.set("ticketToSell", free[0].ticketId);
    client.global.set("ticketToKeep", free[1].ticketId);
    client.global.set("facePrice", free[0].facePrice);
    client.log("팔 티켓 " + free[0].ticketId + "(정가 " + free[0].facePrice + "), 남길 티켓 " + free[1].ticketId);
%}
