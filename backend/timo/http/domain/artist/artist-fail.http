###############################################################################
# 아티스트 목록 조회 - 실패 케이스
#
# artist-success.http 를 먼저 돌려 애플리케이션이 떠 있는지 확인한 뒤 실행한다.
# 선행 데이터가 없어도 되는 케이스들이라 이 파일만 따로 돌려도 된다.
#
# 검증 대상은 "잘못된 요청이 어떤 모양으로 거절되는가" 다. 요청 DTO 검증 실패는
# GlobalExceptionHandler 가 Problem Details 로 바꿔 errors[{field, reason}] 로 내보낸다.
###############################################################################

### 페이지 번호가 음수면 400
GET {{baseUrl}}/api/v1/artists?page=-1

> {%
    client.test("400 과 함께 어느 파라미터가 틀렸는지 알려준다", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.exception === "MethodArgumentNotValidException",
            "exception: " + response.body.exception);
        client.assert(response.body.errors[0].field === "page",
            "field: " + response.body.errors[0].field);
        client.assert(response.body.errors[0].reason === "페이지 번호는 0 이상이어야 합니다.",
            "reason: " + response.body.errors[0].reason);
    });
%}

### 페이지 크기가 상한(100)을 넘으면 400
#
# 상한이 없으면 한 번의 요청으로 아티스트 테이블 전체를 끌어갈 수 있다.
GET {{baseUrl}}/api/v1/artists?size=101

> {%
    client.test("한 번에 가져갈 수 있는 개수를 제한한다", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.errors[0].field === "size",
            "field: " + response.body.errors[0].field);
        client.assert(response.body.errors[0].reason === "페이지 크기는 100 이하여야 합니다.",
            "reason: " + response.body.errors[0].reason);
    });
%}

### 페이지 크기가 0 이면 400
GET {{baseUrl}}/api/v1/artists?size=0

> {%
    client.test("크기는 1 이상이어야 한다", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.errors[0].field === "size",
            "field: " + response.body.errors[0].field);
        client.assert(response.body.errors[0].reason === "페이지 크기는 1 이상이어야 합니다.",
            "reason: " + response.body.errors[0].reason);
    });
%}

### 정렬 기준은 정해진 값만 받는다 (엔티티 필드명을 그대로 넘길 수 없다)
#
# 필드명을 열어 두면 매핑되지 않는 속성일 때 500 이 나고, 매핑되면 내부 모델 구조가
# 그대로 API 규약이 되어 버린다. 허용 값은 NAME / LATEST 뿐이다.
GET {{baseUrl}}/api/v1/artists?sort=name,desc

> {%
    client.test("허용되지 않은 정렬 기준이면 400", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.exception === "MethodArgumentNotValidException",
            "exception: " + response.body.exception);
        client.assert(response.body.errors[0].field === "sort",
            "field: " + response.body.errors[0].field);
    });
%}

### 정의되지 않은 정렬 값이면 400
GET {{baseUrl}}/api/v1/artists?sort=POPULAR

> {%
    client.test("공연에만 있는 정렬 기준은 아티스트에서 받지 않는다", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.errors[0].field === "sort",
            "field: " + response.body.errors[0].field);
    });
%}

### 검색어가 200자를 넘으면 400
GET {{baseUrl}}/api/v1/artists?keyword=가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가나다라마바사아자차가

> {%
    client.test("검색어 길이 상한을 넘기면 400", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.errors[0].field === "keyword",
            "field: " + response.body.errors[0].field);
        client.assert(response.body.errors[0].reason === "검색어는 200자 이하여야 합니다.",
            "reason: " + response.body.errors[0].reason);
    });
%}

### 아티스트 목록 경로에 POST 를 보내면 405 - 내장 예외도 같은 스키마로 나간다
#
# 아티스트는 아직 조회만 있다. 등록 API 가 생기기 전까지 이 경로의 POST 는 405 다.
POST {{baseUrl}}/api/v1/artists
Content-Type: application/json

{}

> {%
    client.test("405 도 Problem Details 로 내려온다", function () {
        client.assert(response.status === 405, "status: " + response.status);
        client.assert(response.body.exception === "HttpRequestMethodNotSupportedException",
            "exception: " + response.body.exception);
        client.assert(response.body.errorMessage !== undefined, "errorMessage 가 없다");
    });
%}
