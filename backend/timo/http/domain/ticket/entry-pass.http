###############################################################################
# 입장 QR 발급 API
#
# 환경 변수는 프로젝트 루트의 http-client.env.json 에 있는 local 을 쓴다.
# 실행 전에 우측 상단 드롭다운에서 local 을 선택해야 {{baseUrl}} 이 치환된다.
#
# ── 먼저 해야 할 일 ──────────────────────────────────────────────────────────
# 같은 폴더의 entry-pass-fixture.sql 을 로컬 DB(timo)에 한 번 돌리고, 그게 찍어 주는
# ticketId 를 아래 @ticketId 에 넣는다.
#
# 로컬 시드는 주문(reservation)까지만 만들고 티켓(ticket) 행은 만들지 않는다. 실제 발행은
# 온체인 민팅을 거치는데 ADMIN_PRIVATE_KEY 없이는 돌지 않기 때문이다. 그 SQL 이 발행이 끝난
# 척하는 티켓 한 장을 넣고, 공연 시작 시각도 입장 창 안으로 당겨 준다. 자세한 건 그 파일 주석.
#
# ddl-auto 가 create-drop 이라 앱을 내리면 같이 사라진다. 다시 띄웠으면 다시 돌린다.
#
# ── 왜 티켓 번호를 손으로 넣나 ──────────────────────────────────────────────
# 티켓 번호를 내려주는 조회 API 가 아직 없다. 양도 등록(CreateListingRequestDto)도 같은 값을
# 요청으로 받으면서 "판매자는 자기 티켓의 식별자를 이미 알고 있다" 를 전제하고 있어, 결국
# 어딘가는 뚫려야 하는 값이다. 그 창구가 생기면 이 변수는 앞 요청에서 받아 채우게 바꾼다.
#
# ── 읽는 법 ─────────────────────────────────────────────────────────────────
# 발급 자체는 서버에 아무것도 남기지 않는다. 그래서 이 파일은 순서 상관없이,
# 몇 번이든 다시 돌려도 된다. 매번 다른 문자열이 나오는 건 만료 시각이 달라서다.
###############################################################################

@ticketId = 1

### 헬스 체크 - 애플리케이션이 떠 있는지 먼저 확인한다
GET {{baseUrl}}/actuator/health

> {%
    client.test("애플리케이션이 살아 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "UP", "health: " + response.body.status);
    });
%}

### 시드 계정으로 로그인 - 입장 QR 은 요청자를 토큰에서만 꺼내므로 accessToken 이 꼭 필요하다
# X-Device-Id 는 필수 헤더다. refresh 토큰이 (member_id, device_id) 로 유일해서 세션을 가르는
# 값이라, 아무 문자열이나 넣어도 로그인은 되고 그 값으로 세션 행 하나가 잡힌다.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
X-Device-Id: http-client-seed001

{
  "username": "seed001",
  "password": "timo1234!"
}

> {%
    client.test("로그인된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.accessToken !== undefined, "accessToken 이 없다");
    });

    client.global.set("entryAccessToken", response.body.accessToken);
%}

### 입장 QR 발급 - 이 파일의 본 목적
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass
Authorization: Bearer {{entryAccessToken}}

> {%
    client.test("200 으로 QR 문자열이 나온다", function () {
        client.assert(response.status === 200,
            "status: " + response.status + " body: " + JSON.stringify(response.body) +
            " (404 면 @ticketId 가 seed001 의 티켓이 아니다. 409 면 픽스처 SQL 의 start_date 갱신을 빠뜨렸다.)");
    });

    client.test("우리 형식이다", function () {
        const token = response.body.token || "";
        // timo:entry:1:<ticketId>.<exp>.<sig> - 앱은 이 문자열을 해석하지 않고 그대로 QR 로 그린다.
        client.assert(/^timo:entry:1:\d+\.\d+\.[A-Za-z0-9_-]{22}$/.test(token), "token: " + token);
    });


    client.test("QR 은 짧게 유지된다", function () {
        // 길어지면 QR 버전이 올라가 칸이 촘촘해지고, 어두운 입장 줄에서 인식률이 떨어진다.
        client.assert(response.body.token.length < 60, "length: " + response.body.token.length);
    });

    client.test("남은 수명을 함께 준다", function () {
        // 앱은 토큰에서 만료를 뽑지 않고 이 값으로 카운트다운을 돌린다.
        // 초 단위 값은 application.yml 의 entry-pass.ttl 이 정하므로 여기에 박아 두지 않는다.
        client.assert(response.body.expiresInSeconds > 0,
            "expiresInSeconds: " + response.body.expiresInSeconds);
    });
%}

### 다시 발급 - 몇 번을 불러도 되고, 부를 때마다 다른 문자열이 나온다
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass
Authorization: Bearer {{entryAccessToken}}

> {%
    client.test("200 이다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });

    client.test("발급은 서버 상태를 바꾸지 않는다", function () {
        // 첫 발급이 티켓을 소진했다면 여기서 409 가 났을 것이다. 입장 처리는 게이트 검증 쪽 몫이다.
        client.assert(response.body.token !== undefined, "두 번째 발급이 비었다");
    });
%}

### 토큰 없이 호출 - 401
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass

> {%
    client.test("인증 없이는 401 이다", function () {
        client.assert(response.status === 401, "status: " + response.status);
    });
%}

### 없는 티켓 - 404
GET {{baseUrl}}/api/v1/tickets/99999999/entry-pass
Authorization: Bearer {{entryAccessToken}}

> {%
    client.test("없는 티켓은 404 다", function () {
        client.assert(response.status === 404, "status: " + response.status);
    });
%}

### 남의 티켓 - 403 이 아니라 404
# 다른 시드 계정으로 갈아타 seed001 의 티켓을 찔러 본다. 403 으로 답하면 "그 번호의 티켓은
# 있다" 를 알려주는 셈이라, 번호를 훑어 예매 현황을 세어 볼 수 있다.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
X-Device-Id: http-client-seed002

{
  "username": "seed002",
  "password": "timo1234!"
}

> {%
    client.test("다른 시드 계정으로 로그인된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });

    client.global.set("otherAccessToken", response.body.accessToken);
%}

###
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass
Authorization: Bearer {{otherAccessToken}}

> {%
    client.test("남의 티켓은 존재를 알리지 않고 404 다", function () {
        client.assert(response.status === 404,
            "status: " + response.status + " (403 이면 티켓의 존재가 새어 나간 것이다)");
    });
%}
