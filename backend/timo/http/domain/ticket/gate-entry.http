###############################################################################
# 게이트 검표 API
#
# 환경 변수는 프로젝트 루트의 http-client.env.json 에 있는 local 을 쓴다.
# 실행 전에 우측 상단 드롭다운에서 local 을 선택해야 {{baseUrl}} 이 치환된다.
#
# ── 먼저 해야 할 일 ──────────────────────────────────────────────────────────
# 같은 폴더의 entry-pass-fixture.sql 을 로컬 DB(timo)에 한 번 돌리고, 그게 찍어 주는
# ticketId · concertId 를 아래 @ticketId · @concertId 에 넣는다.
#
# ── 체인은 필요 없다 ────────────────────────────────────────────────────────
# ADMIN_PRIVATE_KEY 가 더미면 온체인 호출이 한 건도 나가지 않는다. 소유자 조회는
# GateEntryService 가 건너뛰고, 입장 기록(markUsed)은 TicketEntryOnChainService 가
# 조기 리턴한다. 그래서 이 파일은 블록체인 노드 없이 끝까지 돈다 - DB 만 움직인다.
#
# ── 한 줄씩 누르지 말고 파일째 실행한다 ─────────────────────────────────────
# QR 수명은 application.yml 의 entry-pass.ttl 이 정하고 기본이 30초다. 발급받은 QR 을
# 아래 요청 몇 개 뒤에서 쓰기 때문에, 요청을 하나씩 손으로 눌러 진행하면 그 사이에 만료돼
# 정상 검표가 admitted 대신 EXPIRED 로 떨어진다. 파일째 돌리면 전체가 1초도 안 걸린다.
#
# ── 돌릴 때마다 픽스처를 먼저 돌린다 ────────────────────────────────────────
# 검표는 판정이 곧 소진이라, 이 파일을 한 번 돌리면 그 티켓은 USED 가 되고 다음 실행은
# 첫 발급부터 409 로 막힌다. 그러면 뒤 요청들은 QR 이 비어서 줄줄이 실패한다.
#
# entry-pass-fixture.sql 이 USED 를 OWNED 로 되돌려 주므로, 두 번째 실행부터는 매번 그걸
# 먼저 돌리면 된다. 공연 시각도 같이 다시 당겨 준다.
#
# ── 읽는 법 ─────────────────────────────────────────────────────────────────
# 거절도 200 이다. 게이트 앱이 상태 코드를 해석하지 않고 admitted 만 보게 하려는 것이라
# (gate/README.md 규약), 4xx·5xx 는 "판정을 못 했다" 는 뜻으로만 남겨 둔다.
#
# 검표 요청에는 Authorization 헤더가 없다. 게이트 앱에 로그인 화면이 없어 보낼 토큰이
# 없기 때문이다(팀 결정). 로그인은 QR 을 발급받는 앞부분에만 필요하다.
#
# ── 좌석·예매자는 아무 응답에나 실리지 않는다 ───────────────────────────────
# seat 은 허용과 ALREADY_USED 에만, holder 는 허용에만 실린다. 나머지 거절은 운영자가
# 좌석을 알아도 할 일이 없어 싣지 않는다. 필드가 없는 경우 null 이 아니라 아예 나타나지
# 않아야 한다(@JsonInclude NON_NULL) - 게이트 앱이 optional 로 파싱하기 때문이다.
# holder.maskedPhoneNumber 는 서버가 이미 가린 값이다. 앱이 가리면 프록시·로그를 원문이
# 그대로 지나간다.
###############################################################################

# 둘 다 entry-pass-fixture.sql 이 마지막에 찍어 주는 값이다. 시드가 새로 깔리면 달라질 수 있으니
# 아래 값이 맞는다고 가정하지 말고 그때그때 확인한다.
@ticketId = 1
@concertId = 3

### 헬스 체크 - 애플리케이션이 떠 있는지 먼저 확인한다
GET {{baseUrl}}/actuator/health

> {%
    client.test("애플리케이션이 살아 있다", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "UP", "health: " + response.body.status);
    });
%}

### 관람객으로 로그인 - QR 을 발급받기 위해서다. 검표 자체에는 필요 없다
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
X-Device-Id: http-client-seed001

{
  "username": "seed001",
  "password": "timo1234!"
}

> {%
    client.test("로그인된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });

    client.global.set("gateAccessToken", response.body.accessToken);
%}

### 우리 QR 이 아닌 문자열 - INVALID
POST {{baseUrl}}/api/v1/gates/entries/verify
Content-Type: application/json

{
  "qr": "https://example.com",
  "concertId": {{concertId}}
}

> {%
    client.test("200 으로 거절 판정이 온다", function () {
        // 거절은 4xx 가 아니다. 판정을 못 한 것이 아니라 "들여보낼 수 없다" 는 판정 결과다.
        client.assert(response.status === 200, "status: " + response.status);
    });

    client.test("INVALID 로 거절한다", function () {
        client.assert(response.body.admitted === false, "admitted: " + response.body.admitted);
        client.assert(response.body.reasonCode === "INVALID", "reasonCode: " + response.body.reasonCode);
    });

    client.test("티켓이 특정되지 않았으므로 좌석도 예매자도 없다", function () {
        client.assert(response.body.seat === undefined, "seat: " + JSON.stringify(response.body.seat));
        client.assert(response.body.holder === undefined, "holder: " + JSON.stringify(response.body.holder));
    });
%}

### 서명은 깨졌는데 형식은 맞는 문자열 - 역시 INVALID
# 만료 시각만 미래로 늘려 잡은 위조다. "시간이 지났어요" 가 아니라 "유효하지 않아요" 가 나와야
# 한다 - 서명을 만료보다 먼저 보기 때문이다. 순서가 반대면 위조 시도가 그냥 묻힌다.
POST {{baseUrl}}/api/v1/gates/entries/verify
Content-Type: application/json

{
  "qr": "timo:entry:1:{{ticketId}}.9999999999.AAAAAAAAAAAAAAAAAAAAAA",
  "concertId": {{concertId}}
}

> {%
    client.test("만료가 아니라 INVALID 다", function () {
        client.assert(response.body.reasonCode === "INVALID", "reasonCode: " + response.body.reasonCode);
    });
%}

### QR 첫 장 - 실제로 입장에 쓸 것
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass
Authorization: Bearer {{gateAccessToken}}

> {%
    client.test("발급된다", function () {
        client.assert(response.status === 200,
            "status: " + response.status + " body: " + JSON.stringify(response.body) +
            " (409 면 대개 직전 실행에서 이 티켓이 USED 로 소진된 것이다 - entry-pass-fixture.sql 을 다시 돌린다." +
            " 공연 시각이 입장 창 밖이어도 409 인데 그것도 같은 SQL 이 고쳐 준다." +
            " 404 면 @ticketId 가 seed001 의 티켓이 아니다.)");
    });

    client.global.set("gateQrFirst", response.body.token);
%}

### QR 둘째 장 - 아래에서 "QR 재사용이 아닌데도 막히는지" 를 본다
# 토큰은 (티켓, 만료초) 의 결정적 함수라 같은 초에 두 번 받으면 첫 장과 글자까지 똑같다.
# 그게 정상이다 - 같은 초에 유효한 입장권은 하나뿐이고, 발급이 서버 상태를 바꾸지 않으므로
# 몇 번을 받든 같은 값이 나온다. 초가 넘어가면 exp 가 달라져 서명도 달라진다.
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass
Authorization: Bearer {{gateAccessToken}}

> {%
    client.test("발급된다", function () {
        client.assert(response.status === 200, "status: " + response.status);
    });

    client.test("여전히 우리 형식이다", function () {
        client.assert(/^timo:entry:1:\d+\.\d+\.[A-Za-z0-9_-]{22}$/.test(response.body.token || ""),
            "token: " + response.body.token);
    });

    client.global.set("gateQrSecond", response.body.token);
%}

### 옆 공연 게이트에 들이민 경우 - WRONG_CONCERT
POST {{baseUrl}}/api/v1/gates/entries/verify
Content-Type: application/json

{
  "qr": "{{gateQrFirst}}",
  "concertId": 99999999
}

> {%
    client.test("WRONG_CONCERT 로 거절한다", function () {
        client.assert(response.body.reasonCode === "WRONG_CONCERT", "reasonCode: " + response.body.reasonCode);
    });

    client.test("티켓은 아직 살아 있다", function () {
        // 공연 검사는 소진보다 앞이라 여기서 표가 타면 안 된다. 다음 요청이 통과해야 맞다.
        client.assert(response.body.admitted === false, "admitted: " + response.body.admitted);
    });

    client.test("옆 공연 게이트에 좌석을 알려주지 않는다", function () {
        client.assert(response.body.seat === undefined, "seat: " + JSON.stringify(response.body.seat));
    });
%}

### 정상 검표 - 여기서 티켓이 소진된다
POST {{baseUrl}}/api/v1/gates/entries/verify
Content-Type: application/json

{
  "qr": "{{gateQrFirst}}",
  "concertId": {{concertId}}
}

> {%
    client.test("입장시킨다", function () {
        client.assert(response.body.admitted === true,
            "admitted: " + response.body.admitted + " reasonCode: " + response.body.reasonCode +
            " (WRONG_CONCERT 면 @concertId 가 이 티켓의 공연이 아니다. 픽스처 SQL 이 찍어 준 concertId 를 넣는다. " +
            "EXPIRED 면 요청을 한 줄씩 눌러 진행하느라 QR 수명이 지난 것이다 - 파일째 실행한다. " +
            "ALREADY_USED 면 앞선 실행에서 이미 소진된 것이다.)");
    });

    client.test("거절 사유는 응답에 없다", function () {
        client.assert(response.body.reasonCode === undefined, "reasonCode: " + response.body.reasonCode);
    });

    client.test("자리 안내에 쓸 좌석이 실린다", function () {
        const seat = response.body.seat;
        client.assert(seat !== undefined && seat !== null, "seat 이 없다: " + JSON.stringify(response.body));
        client.assert(typeof seat.sectionName === "string" && seat.sectionName.length > 0,
            "sectionName: " + seat.sectionName);
        client.assert(Number.isInteger(seat.seatNo) && Number.isInteger(seat.seatCol),
            "seatNo/seatCol: " + seat.seatNo + "/" + seat.seatCol);
    });

    client.test("연락처는 서버가 가려서 내려준다", function () {
        const holder = response.body.holder;
        client.assert(holder !== undefined && holder !== null, "holder 가 없다: " + JSON.stringify(response.body));
        client.assert(typeof holder.name === "string" && holder.name.length > 0, "name: " + holder.name);
        // 앱이 가리는 것이 아니다. 여기에 원문이 보이면 프록시·접근 로그에도 원문이 남고 있다는 뜻이다.
        client.assert(/^\d{3}\*{4}\d{4}$/.test(holder.maskedPhoneNumber || ""),
            "maskedPhoneNumber: " + holder.maskedPhoneNumber);
    });
%}

### 같은 QR 재사용 - ALREADY_USED
# 캡처해서 넘긴 QR 이 여기서 걸린다.
POST {{baseUrl}}/api/v1/gates/entries/verify
Content-Type: application/json

{
  "qr": "{{gateQrFirst}}",
  "concertId": {{concertId}}
}

> {%
    client.test("ALREADY_USED 로 거절한다", function () {
        client.assert(response.body.reasonCode === "ALREADY_USED", "reasonCode: " + response.body.reasonCode);
    });

    client.test("이미 입장한 그 자리를 확인시켜 줄 좌석이 실린다", function () {
        client.assert(response.body.seat !== undefined && response.body.seat !== null,
            "seat 이 없다: " + JSON.stringify(response.body));
    });

    client.test("들여보내지 않은 사람의 예매자 정보는 싣지 않는다", function () {
        client.assert(response.body.holder === undefined, "holder: " + JSON.stringify(response.body.holder));
    });
%}

### 아까 미리 받아 둔 둘째 장 - 역시 ALREADY_USED
# 막는 주체가 "이 QR 을 썼는가" 가 아니라 "이 티켓이 입장했는가" 라는 것을 보는 요청이다.
# QR 문자열마다 사용 여부를 기억하는 테이블(nonce·Redis)이 없는 이유가 이것이다.
#
# 다만 둘째 장을 첫 장과 같은 초에 받았다면 문자열이 같아서 위 재사용 요청과 구분이 안 된다.
# 초를 넘겨 받은 경우에만 "다른 문자열인데도 막힌다" 가 된다. 문자열이 확실히 다른 조건은
# GateEntryServiceTest 의 rejectsAlreadyUsedTicket 이 고정한다.
POST {{baseUrl}}/api/v1/gates/entries/verify
Content-Type: application/json

{
  "qr": "{{gateQrSecond}}",
  "concertId": {{concertId}}
}

> {%
    client.test("다른 QR 로도 두 번째 입장은 안 된다", function () {
        client.assert(response.body.reasonCode === "ALREADY_USED", "reasonCode: " + response.body.reasonCode);
    });
%}

### 입장한 티켓은 QR 을 더 내주지 않는다 - 409
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/entry-pass
Authorization: Bearer {{gateAccessToken}}

> {%
    client.test("발급 단계에서 막힌다", function () {
        // 발급은 OWNED 만 통과시킨다. 게이트까지 가기 전에 앱 화면에서 먼저 끊긴다.
        client.assert(response.status === 409,
            "status: " + response.status + " body: " + JSON.stringify(response.body));
    });
%}
