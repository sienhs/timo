###############################################################################
# 내 티켓 조회 - 실패 케이스
#
# ticket-common.http 를 먼저 실행해 {{sellerToken}} 을 채워 둬야 한다.
#
# 조회 API 라 실패 갈래가 인증과 요청 형식뿐이다. 남의 목록을 보는 통로 자체가
# 없어서(요청자를 토큰에서만 받는다) 403 케이스가 없다.
###############################################################################

### 토큰이 없으면 401
GET {{baseUrl}}/api/v1/tickets/me

> {%
    client.test("401 이고 errorCode 로 앱이 로그아웃을 판단한다", function () {
        client.assert(response.status === 401, "status: " + response.status);
        client.assert(response.body.errorCode === "TOKEN_INVALID", "errorCode: " + response.body.errorCode);
    });
%}

### 망가진 토큰도 401
GET {{baseUrl}}/api/v1/tickets/me
Authorization: Bearer not-a-real-token

> {%
    client.test("401 TOKEN_INVALID", function () {
        client.assert(response.status === 401, "status: " + response.status);
        client.assert(response.body.errorCode === "TOKEN_INVALID", "errorCode: " + response.body.errorCode);
    });
%}

### 페이지 크기가 상한(100)을 넘으면 400
GET {{baseUrl}}/api/v1/tickets/me?size=101
Authorization: Bearer {{sellerToken}}

> {%
    client.test("400 이고 어느 필드가 틀렸는지 알려준다", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(JSON.stringify(response.body.errors).indexOf("size") >= 0,
                "errors: " + JSON.stringify(response.body.errors));
    });
%}

### 페이지 크기가 0 이면 400
GET {{baseUrl}}/api/v1/tickets/me?size=0
Authorization: Bearer {{sellerToken}}

> {%
    client.test("400 이다", function () {
        client.assert(response.status === 400, "status: " + response.status);
    });
%}

### 페이지 번호가 음수면 400
GET {{baseUrl}}/api/v1/tickets/me?page=-1
Authorization: Bearer {{sellerToken}}

> {%
    client.test("400 이다", function () {
        client.assert(response.status === 400, "status: " + response.status);
    });
%}

### 페이지 번호가 숫자가 아니면 400
GET {{baseUrl}}/api/v1/tickets/me?page=abc
Authorization: Bearer {{sellerToken}}

> {%
    client.test("400 이다", function () {
        client.assert(response.status === 400, "status: " + response.status);
    });
%}
