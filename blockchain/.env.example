# 지갑별 DEK를 감싸는 마스터키 (64자 hex, envelope encryption)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_MASTER_KEY=

# Amoy RPC 주소 (비우면 기본 공개 RPC 사용)
AMOY_RPC_URL=

# Amoy 트랜잭션 서명용 운영자 개인키 (파우셋으로 충전 필요, --network amoy 전용)
OPERATOR_PRIVATE_KEY=

# deploy.ts 전용 admin 지갑 개인키 (Hardhat 기본 계정 대신 사용 - RPC가
# 외부에 노출돼도 안전. hardhat/localhost에선 잔액 자동 충전됨)
# 생성: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
ADMIN_PRIVATE_KEY=
