# Master key that wraps each wallet's random per-wallet DEK (envelope
# encryption - see src/wallet/custodialWallet.ts). Must be a 64-character
# hex string (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Prototype only - a real deployment should pull this from a KMS instead of
# an env var; see the doc comment on getMasterKey() for what that swap looks like.
WALLET_MASTER_KEY=

# Only needed when deploying to the Polygon Amoy testnet (--network amoy).
AMOY_RPC_URL=
OPERATOR_PRIVATE_KEY=
